{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CarService_db;Trusted_Connection=false;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "ClientId": "api-client",
    "Audience": "account",
    "Realm": "car_service",
    "AdminUser": "admin",
    "AdminPassword": "admin",
    "AdminClientId": "admin-cli"
  },
  "Authentication": {
    "MetadataAddress": "http://keycloak:8080/realms/car_service/.well-known/openid-configuration",
    "ValidIssuer": "http://keycloak:8080/realms/car_service"
  }
}
